* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
# Research receipts bind exact bytes; never normalize their line endings.
docs/benchmarks/cc_v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/data/provenance/cc_v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Generated vector assets and verbatim third-party notices are not source formatting targets.
docs/benchmarks/cc_v2/figures/*.svg binary
docs/benchmarks/cc_v2/reproducibility/licenses/** -whitespace
